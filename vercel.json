{
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/survey_website/assets/$1"
    },
    {
      "src": "/css/(.*)",
      "dest": "/survey_website/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "/survey_website/js/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/survey_website/$1"
    }
  ]
}
